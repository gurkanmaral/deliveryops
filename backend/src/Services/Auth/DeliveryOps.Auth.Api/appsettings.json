{
  "Jwt": {
    "Issuer": "deliveryops-auth",
    "Audience": "deliveryops-api",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Database": {
    "AutoMigrate": false
  },
  "AuthRetention": {
    "Enabled": true,
    "ExpiredRefreshTokenDays": 30,
    "ScanIntervalHours": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
