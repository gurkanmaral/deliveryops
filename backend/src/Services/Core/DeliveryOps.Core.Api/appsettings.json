{
  "Jwt": {
    "Issuer": "deliveryops-auth",
    "Audience": "deliveryops-api"
  },
  "Notifications": {
    "BaseUrl": "http://localhost:5300/",
    "InternalApiKey": ""
  },
  "Integrations": {
    "BaseUrl": "http://localhost:5400/",
    "InternalApiKey": ""
  },
  "IntegrationOutbox": {
    "MaxAttempts": 8
  },
  "NotificationOutbox": {
    "MaxAttempts": 8
  },
  "CoreRetention": {
    "Enabled": true,
    "LocationDays": 30,
    "AuditDays": 365,
    "ProcessedOutboxDays": 7,
    "OrderPiiDays": 90,
    "OrderPiiBatchSize": 500,
    "ScanIntervalHours": 24
  },
  "OrderPii": {
    "SearchKey": "",
    "KeyRingPath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
