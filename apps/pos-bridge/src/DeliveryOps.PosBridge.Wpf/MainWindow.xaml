<Window x:Class="DeliveryOps.PosBridge.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeliveryOps POS Bridge" Width="1120" Height="760" MinWidth="920" MinHeight="660"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="268"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#191D40" Offset="0"/><GradientStop Color="#0F1228" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid Margin="24,26,24,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="13" Background="#6668E8"><TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="DeliveryOps" Foreground="White" FontSize="18" FontWeight="Bold"/><TextBlock Text="POS CONNECT" Foreground="#8994C0" FontSize="9" FontWeight="Bold"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,54,0,0">
                    <TextBlock Text="CANLI BAĞLANTI" Foreground="#7E88B2" FontSize="10" FontWeight="Bold"/>
                    <Border Margin="0,14,0,0" Padding="16" CornerRadius="15" Background="#20264A" BorderBrush="#343B69" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><Border Width="28" Height="28" CornerRadius="9" Background="#183F49"><TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#35D5E5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="SERVİS DURUMU" Foreground="#7F89B0" FontSize="8" FontWeight="Bold"/></StackPanel></StackPanel>
                            <TextBlock Text="{Binding StatusDetail}" Margin="0,13,0,0" TextWrapping="Wrap" Foreground="#A5AED0" FontSize="11" LineHeight="17"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,14,0,0" Padding="14" CornerRadius="13" Background="#171B38"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons" Foreground="#939DD0" FontSize="15" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding PendingFileText}" Margin="10,0,0,0" Foreground="#B7BED8" FontSize="11" TextWrapping="Wrap"/></Grid></Border>
                </StackPanel>
                <StackPanel Grid.Row="2"><Border Height="1" Background="#292E54" Margin="0,0,0,16"/><TextBlock Text="SECURE LOCAL BRIDGE" Foreground="#687298" FontSize="9" FontWeight="Bold"/><TextBlock Text="v1.0 • Windows x64" Margin="0,5,0,0" Foreground="#838CAF" FontSize="10"/></StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,34,40,46">
                <Grid Margin="0,0,0,28">
                    <StackPanel><TextBlock Text="MASAÜSTÜ BAĞLANTISI" Foreground="{StaticResource PrimaryBrush}" FontSize="10" FontWeight="Bold"/><TextBlock Text="POS operasyon merkezi" Margin="0,7,0,0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/><TextBlock Text="Sipariş klasörünü izleyin, doğrulayın ve DeliveryOps'a güvenle aktarın." Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" FontSize="14"/></StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,8" CornerRadius="20" Background="{StaticResource CyanSoftBrush}"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#0D9488" VerticalAlignment="Center"/><TextBlock Text=" Şifreli bağlantı" Foreground="#087A82" FontSize="11" FontWeight="SemiBold"/></StackPanel></Border>
                </Grid>
                <Border Padding="24" Background="{StaticResource SurfaceBrush}" CornerRadius="20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22"><Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource PrimarySoftBrush}"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource PrimaryBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="Bağlantı ayarları" Foreground="{StaticResource InkBrush}" FontSize="16" FontWeight="Bold"/><TextBlock Text="Panelden oluşturulan POS webhook bilgileri" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="Webhook URL" Style="{StaticResource FieldLabel}"/><TextBox Margin="0,8,0,18" Text="{Binding WebhookUrl, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="POS sipariş klasörü" Style="{StaticResource FieldLabel}"/><TextBox Margin="0,8,0,0" Text="{Binding InboxDirectory, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="X-DeliveryOps-Key" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="SecretBox" Margin="0,8,0,18" PasswordChanged="SecretBox_OnPasswordChanged"/><TextBlock Text="Kontrol aralığı (saniye)" Style="{StaticResource FieldLabel}"/><TextBox Margin="0,8,0,0" Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding ValidationMessage}" Margin="3,11,0,0" Foreground="#D04458" TextWrapping="Wrap" FontSize="12"/>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,26">
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource SecondaryButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/><TextBlock Text="Ayarları kaydet"/></StackPanel></Button>
                    <Button Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/><TextBlock Text="Bridge'i başlat"/></StackPanel></Button>
                    <Button Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" Margin="10,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/><TextBlock Text="Durdur"/></StackPanel></Button>
                    <Button Command="{Binding ProcessNowCommand}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/><TextBlock Text="Şimdi kontrol et"/></StackPanel></Button>
                </StackPanel>
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="290"/></Grid.RowDefinitions>
                        <Grid Margin="22,19"><StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource CyanSoftBrush}"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" Foreground="#0794A9" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="İşlem günlüğü" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/><TextBlock Text="Dosya aktarım ve doğrulama olayları" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></StackPanel><TextBlock Text="{Binding LastCycleText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8993A8" FontSize="11"/></Grid>
                        <ListView Grid.Row="1" ItemsSource="{Binding Logs}" BorderThickness="0" Background="#FAFBFF"><ListView.View><GridView><GridViewColumn Header="ZAMAN" Width="150" DisplayMemberBinding="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"/><GridViewColumn Header="SEVİYE" Width="90" DisplayMemberBinding="{Binding Level}"/><GridViewColumn Header="SİPARİŞ" Width="155" DisplayMemberBinding="{Binding ExternalOrderId}"/><GridViewColumn Header="MESAJ" Width="365" DisplayMemberBinding="{Binding Message}"/></GridView></ListView.View></ListView>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
