{
  "expo": {
    "name": "DeliveryOps Kurye",
    "slug": "deliveryops-courier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deliveryops-courier",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.deliveryops.courier",
      "supportsTablet": false
    },
    "android": {
      "package": "com.deliveryops.courier",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#F0521A",
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DeliveryOps, aktif vardiyanız sırasında konumunuzu operasyon merkezine iletir.",
          "locationAlwaysAndWhenInUsePermission": "DeliveryOps, aktif teslimat sırasında uygulama arka plandayken de konumunuzu operasyon merkezine iletir.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
